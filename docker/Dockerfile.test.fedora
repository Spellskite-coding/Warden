# Full systemd-as-PID1 test image for the dnf/Fedora-family branch of
# install.sh's install_packages() - the branch covering
# fedora/rhel/rocky/almalinux/centos, previously untested end-to-end
# (install.sh's own comment said so). Unlike Dockerfile.test.debian (a
# quick binary-only smoke test), this runs the *actual installer* against
# a live systemd, the same way a real machine would experience it.
FROM fedora:latest

ENV container=docker

RUN dnf install -y systemd sudo procps-ng passwd git \
    && dnf clean all \
    && systemctl mask systemd-udevd.service systemd-udevd-kernel.socket \
        systemd-udevd-control.socket getty.target getty-static.service \
        systemd-remount-fs.service sys-kernel-config.mount || true

RUN useradd -m -u 1500 tester && echo "tester:tester" | chpasswd \
    && mkdir -p /home/tester/Documents /home/tester/Desktop \
    && echo "just a normal text document" > /home/tester/Documents/notes.txt \
    && chown -R tester:tester /home/tester

COPY . /opt/warden-src
RUN chown -R tester:tester /opt/warden-src

STOPSIGNAL SIGRTMIN+3
VOLUME ["/sys/fs/cgroup"]
CMD ["/sbin/init"]
